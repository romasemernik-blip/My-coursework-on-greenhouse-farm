actions_log.txt
save_data/
storage_export.txt
storage.txt

# Игнорируем все текстовые файлы, которые генерирует или использует программа
*.txt

# Но если у вас есть важные текстовые файлы конфигурации (например, CMakeLists.txt), 
# которые должны быть в репозитории, мы делаем для них исключение:
!CMakeLists.txt

